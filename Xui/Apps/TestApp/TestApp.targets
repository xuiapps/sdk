<Project>

  <PropertyGroup>
    <RootNamespace>Xui.Apps.TestApp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ApplicationTitle>Xui TestApp</ApplicationTitle>
    <ApplicationId>com.xuiapps.TestApp</ApplicationId>

    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
	  <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Desktop and emulator image loading resolves relative paths from the app output. -->
  <ItemGroup Condition="'$(XuiDesktop)' == 'true' Or '$(XuiEmulator)' == 'true'">
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- "bin" in atlas.bin.gz is a culture name on Windows; keep these assets in the main assembly. -->
    <EmbeddedResource Include="Assets/FloorplanGpu/atlas.bin.gz;Assets/FloorplanGpu/quads-l*.bin;Assets/FloorplanGpu/structure-l*.bin;Assets/FloorplanGpu/atlas.json" LogicalName="TestApp.FloorplanGpu.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Assets/Floorplan/Office.svg" LogicalName="TestApp.Floorplan.Office.svg" />
  </ItemGroup>
</Project>
